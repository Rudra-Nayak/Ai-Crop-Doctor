GROQ_API_KEY=gsk_your_key_here

# Models
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=meta-llama/llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=atlas

# RAG
EMBEDDING_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./knowledge_base/faiss_index

# Agent
CONFIDENCE_THRESHOLD=0.70
MAX_AGENT_ITERATIONS=8

# Supabase Integration (Cloud Database, pgvector RAG, Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_anon_or_service_key_here
USE_SUPABASE_RAG=true
USE_SUPABASE_SESSION=true
USE_SUPABASE_STORAGE=true
